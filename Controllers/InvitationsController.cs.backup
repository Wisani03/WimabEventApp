using System.Security.Claims;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using WimabEventApp.Data;
using WimabEventApp.Models;

[Route("api/events/{eventId}/invitations")]
[ApiController]
[Authorize]
public class InvitationsController : ControllerBase
{
    private readonly AppDbContext _context;

    public InvitationsController(AppDbContext context)
    {
        _context = context;
    }

    private string? GetCurrentUserId()
    {
        return User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private async Task<bool> UserOwnsEvent(int eventId, string userId)
    {
        return await _context.Events
            .AnyAsync(e => e.Id == eventId && e.UserId == userId);
    }

    // =========================================================
    // HOST: GET ALL INVITATIONS FOR AN EVENT
    // =========================================================

    [HttpGet]
    public async Task<ActionResult<IEnumerable<Invitation>>> GetInvitations(
        int eventId)
    {
        var userId = GetCurrentUserId();

        if (string.IsNullOrEmpty(userId))
        {
            return Unauthorized(new
            {
                message = "You are not logged in."
            });
        }

        if (!await UserOwnsEvent(eventId, userId))
        {
            return NotFound(new
            {
                message = "Event not found."
            });
        }

        var invitations = await _context.Invitations
            .Include(i => i.Guest)
            .Where(i => i.EventId == eventId)
            .ToListAsync();

        return Ok(invitations);
    }


    // =========================================================
    // HOST: CREATE INVITATION
    // =========================================================

    [HttpPost]
    public async Task<ActionResult<Invitation>> CreateInvitation(
        int eventId,
        [FromBody] Invitation invitation)
    {
        var userId = GetCurrentUserId();

        if (string.IsNullOrEmpty(userId))
        {
            return Unauthorized(new
            {
                message = "You are not logged in."
            });
        }

        if (!await UserOwnsEvent(eventId, userId))
        {
            return NotFound(new
            {
                message = "Event not found."
            });
        }

        if (string.IsNullOrWhiteSpace(invitation.GuestName))
        {
            return BadRequest(new
            {
                message = "Guest name is required."
            });
        }

        if (string.IsNullOrWhiteSpace(invitation.GuestEmail) &&
            string.IsNullOrWhiteSpace(invitation.GuestPhoneNumber))
        {
            return BadRequest(new
            {
                message = "Guest email or phone number is required."
            });
        }

        invitation.EventId = eventId;
        invitation.Event = null;

        // Generate unique invitation link
        invitation.InviteGuid = Guid.NewGuid().ToString("N");

        invitation.RsvpStatus = "Pending";
        invitation.IsAccepted = false;
        invitation.BringingPlusOne = false;
        invitation.IsAttended = false;
        invitation.Guest = null;

        _context.Invitations.Add(invitation);

        await _context.SaveChangesAsync();

        return CreatedAtAction(
            nameof(GetInvitations),
            new { eventId },
            invitation);
    }


    // =========================================================
    // PUBLIC: GET INVITATION
    // =========================================================

    [HttpGet("~/api/invitations/public/{inviteGuid}")]
    [AllowAnonymous]
    public async Task<IActionResult> GetPublicInvitation(
        string inviteGuid)
    {
        var invitation = await _context.Invitations
            .Include(i => i.Event)
            .Include(i => i.Guest)
            .FirstOrDefaultAsync(i => i.InviteGuid == inviteGuid);

        if (invitation == null)
        {
            return NotFound(new
            {
                message = "This invitation could not be found."
            });
        }

        var eventItem = invitation.Event;

        if (eventItem == null)
        {
            return NotFound(new
            {
                message =
                    "The event associated with this invitation could not be found."
            });
        }

        // Check RSVP deadline
        var deadlinePassed =
            eventItem.RsvpDeadline.HasValue &&
            DateTime.UtcNow >
            eventItem.RsvpDeadline.Value.ToUniversalTime();

        return Ok(new
        {
            invitation = new
            {
                id = invitation.Id,
                guestName = invitation.GuestName,
                guestEmail = invitation.GuestEmail,
                guestPhoneNumber = invitation.GuestPhoneNumber,
                inviteGuid = invitation.InviteGuid,
                rsvpStatus = invitation.RsvpStatus,
                isAccepted = invitation.IsAccepted,
                bringingPlusOne = invitation.BringingPlusOne,
                isAttended = invitation.IsAttended,
                ticketCode = invitation.Guest?.TicketCode
            },

            eventDetails = new
            {
                id = eventItem.Id,
                title = eventItem.Title,
                category = eventItem.Category,
                description = eventItem.Description,
                venueLocation = eventItem.VenueLocation,
                theme = eventItem.Theme,
                attire = eventItem.Attire,
                eventDate = eventItem.EventDate,
                rsvpDeadline = eventItem.RsvpDeadline
            },

            rsvpClosed = deadlinePassed
        });
    }


    // =========================================================
    // PUBLIC: RSVP TO INVITATION
    // =========================================================

    [HttpPost("~/api/invitations/public/{inviteGuid}/rsvp")]
    [AllowAnonymous]
    public async Task<IActionResult> SubmitRsvp(
        string inviteGuid,
        [FromBody] PublicRsvpRequest request)
    {
        var invitation = await _context.Invitations
            .Include(i => i.Event)
            .Include(i => i.Guest)
            .FirstOrDefaultAsync(i => i.InviteGuid == inviteGuid);

        if (invitation == null)
        {
            return NotFound(new
            {
                message = "This invitation could not be found."
            });
        }

        var eventItem = invitation.Event;

        if (eventItem == null)
        {
            return NotFound(new
            {
                message =
                    "The event associated with this invitation could not be found."
            });
        }

        // ---------------------------------------------------------
        // CHECK RSVP DEADLINE
        // ---------------------------------------------------------

        if (eventItem.RsvpDeadline.HasValue &&
            DateTime.UtcNow >
            eventItem.RsvpDeadline.Value.ToUniversalTime())
        {
            return BadRequest(new
            {
                message = "The RSVP deadline for this event has passed.",
                rsvpClosed = true
            });
        }

        // ---------------------------------------------------------
        // VALIDATE NAME
        // ---------------------------------------------------------

        if (string.IsNullOrWhiteSpace(request.Name) ||
            string.IsNullOrWhiteSpace(request.Surname))
        {
            return BadRequest(new
            {
                message = "Name and surname are required."
            });
        }

        // ---------------------------------------------------------
        // DECLINED
        // ---------------------------------------------------------

        if (!request.IsAttending)
        {
            invitation.RsvpStatus = "Declined";
            invitation.IsAccepted = false;
            invitation.BringingPlusOne = false;

            if (invitation.Guest != null)
            {
                invitation.Guest.IsAttending = false;
            }

            await _context.SaveChangesAsync();

            return Ok(new
            {
                message = "RSVP declined successfully.",
                rsvpStatus = "Declined",
                isAttending = false
            });
        }

        // ---------------------------------------------------------
        // ACCEPTED
        // ---------------------------------------------------------

        invitation.RsvpStatus = "Accepted";
        invitation.IsAccepted = true;

        invitation.BringingPlusOne =
            !string.IsNullOrWhiteSpace(request.PlusOneName);

        Guest guest;

        // ---------------------------------------------------------
        // CREATE GUEST RECORD
        // ---------------------------------------------------------

        if (invitation.Guest == null)
        {
            guest = new Guest
            {
                EventId = invitation.EventId,

                InvitationId = invitation.Id,

                Name = request.Name.Trim(),

                Surname = request.Surname.Trim(),

                PhoneNumber =
                    request.Phone?.Trim() ?? "",

                IsAttending = true,

                DietaryRequirements =
                    request.DietaryRequirements?.Trim(),

                PlusOneName =
                    request.PlusOneName?.Trim(),

                RSVPDate = DateTime.UtcNow,

                // Unique ticket code
                TicketCode =
                    $"WIMAB-{Guid.NewGuid().ToString("N")[..10].ToUpper()}"
            };

            _context.Guests.Add(guest);
        }
        else
        {
            // -----------------------------------------------------
            // UPDATE EXISTING GUEST
            // -----------------------------------------------------

            guest = invitation.Guest;

            guest.Name =
                request.Name.Trim();

            guest.Surname =
                request.Surname.Trim();

            guest.PhoneNumber =
                request.Phone?.Trim() ?? "";

            guest.IsAttending = true;

            guest.DietaryRequirements =
                request.DietaryRequirements?.Trim();

            guest.PlusOneName =
                request.PlusOneName?.Trim();

            guest.RSVPDate =
                DateTime.UtcNow;

            if (string.IsNullOrWhiteSpace(guest.TicketCode))
            {
                guest.TicketCode =
                    $"WIMAB-{Guid.NewGuid().ToString("N")[..10].ToUpper()}";
            }
        }

        await _context.SaveChangesAsync();

        // ---------------------------------------------------------
        // RSVP SUCCESS
        // ---------------------------------------------------------

        return Ok(new
        {
            message = "RSVP accepted successfully!",

            rsvpStatus = "Accepted",

            isAttending = true,

            ticketCode = guest.TicketCode,

            guestName = guest.Name,

            guestSurname = guest.Surname
        });
    }


    // =========================================================
    // HOST: DELETE INVITATION
    // =========================================================

    [HttpDelete("{id}")]
    public async Task<IActionResult> DeleteInvitation(
        int eventId,
        int id)
    {
        var userId = GetCurrentUserId();

        if (string.IsNullOrEmpty(userId))
        {
            return Unauthorized(new
            {
                message = "You are not logged in."
            });
        }

        if (!await UserOwnsEvent(eventId, userId))
        {
            return NotFound(new
            {
                message = "Event not found."
            });
        }

        var invitation = await _context.Invitations
            .FirstOrDefaultAsync(
                i => i.Id == id &&
                     i.EventId == eventId);

        if (invitation == null)
        {
            return NotFound(new
            {
                message = "Invitation not found."
            });
        }

        _context.Invitations.Remove(invitation);

        await _context.SaveChangesAsync();

        return NoContent();
    }
}


// =============================================================
// PUBLIC RSVP REQUEST
// =============================================================

public class PublicRsvpRequest
{
    public string Name { get; set; } = string.Empty;

    public string Surname { get; set; } = string.Empty;

    public string? Phone { get; set; }

    public bool IsAttending { get; set; }

    public string? DietaryRequirements { get; set; }

    public string? PlusOneName { get; set; }
}