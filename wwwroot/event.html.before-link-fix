</head>

<body>

    <nav class="navbar">

        <a href="./dashboard.html" class="brand">
            <i data-lucide="calendar-heart" class="brand-icon"></i>
            Wimab Events
        </a>

        <a href="./events.html" class="back-link">
            <i data-lucide="arrow-left"></i>
            <span>Back to Events</span>
        </a>

    </nav>

    <main class="container">

        <div id="loading" class="loading">
            <div class="spinner"></div>
            <p>Loading event...</p>
        </div>

        <div id="errorBox" class="error-box">

            <i data-lucide="circle-alert" size="42" class="error-icon"></i>

            <h2>Unable to load event</h2>

            <p id="errorMessage">
                We couldn't find this event.
            </p>

            <a href="./events.html" class="primary-button">
                <i data-lucide="arrow-left"></i>
                Back to Events
            </a>

        </div>

        <div id="eventContent" class="event-content">

            <section class="event-hero">

                <div class="category-badge">
                    <i data-lucide="tag" size="14"></i>
                    <span id="eventCategory">General</span>
                </div>

                <h1 class="event-title" id="eventTitle">
                    Event Title
                </h1>

                <p class="event-description" id="eventDescription">
                    Event description
                </p>

            </section>

            <section class="event-meta">

                <div class="meta-card">

                    <div class="meta-icon">
                        <i data-lucide="calendar-days"></i>
                    </div>

                    <div class="meta-content">
                        <span>Date</span>
                        <strong id="eventDate">—</strong>
                    </div>

                </div>

                <div class="meta-card">

                    <div class="meta-icon">
                        <i data-lucide="map-pin"></i>
                    </div>

                    <div class="meta-content">
                        <span>Venue</span>
                        <strong id="eventVenue">—</strong>
                    </div>

                </div>

                <div class="meta-card">

                    <div class="meta-icon">
                        <i data-lucide="palette"></i>
                    </div>

                    <div class="meta-content">
                        <span>Theme</span>
                        <strong id="eventTheme">—</strong>
                    </div>

                </div>

                <div class="meta-card">

                    <div class="meta-icon">
                        <i data-lucide="shirt"></i>
                    </div>

                    <div class="meta-content">
                        <span>Attire</span>
                        <strong id="eventAttire">—</strong>
                    </div>

                </div>

            </section>

            <section class="section">

                <div class="section-header">

                    <h2 class="section-title">
                        <i data-lucide="gift"></i>
                        Wishlist
                    </h2>

                    <span class="wishlist-count" id="wishlistCount">
                        0 items
                    </span>

                </div>

                <div id="wishlistContainer" class="wishlist-grid"></div>

            </section>

            <section class="section">

    <div class="section-header">

        <h2 class="section-title">
            <i data-lucide="users"></i>
            Invitations
        </h2>

        <button
            type="button"
            onclick="openInvitationForm()"
            class="invite-button">
            <i data-lucide="send" size="16"></i>
            Send Invitation
        </button>

    </div>

    <div class="invitation-box">

        <div class="invitation-count">

            <div class="invitation-count-icon">
                <i data-lucide="user-round-check"></i>
            </div>

            <div>
                <strong id="invitationCount">0</strong>
                <span>people invited to this event</span>
            </div>

        </div>

    </div>


    <!-- SEND INVITATION FORM -->

    <div
        id="invitationForm"
        class="invitation-form"
        style="display: none;">

        <div class="form-header">
            <div>
                <h3>Send Invitation</h3>
                <p>Invite someone to this event.</p>
            </div>

            <button
