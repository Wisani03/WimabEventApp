    </main>

    <script>
        const API_URL = "/api/events";

        const loading = document.getElementById("loading");
        const errorBox = document.getElementById("errorBox");
        const errorMessage = document.getElementById("errorMessage");
        const eventContent = document.getElementById("eventContent");

        const urlParams = new URLSearchParams(window.location.search);
        const eventId = urlParams.get("id");

        if (eventId) {
            localStorage.setItem("wimab_current_eventid", eventId);
        }

        function formatDate(dateString) {
            if (!dateString) {
                return "Not specified";
            }

            const date = new Date(dateString);

            if (isNaN(date.getTime())) {
                return dateString;
            }

            return date.toLocaleDateString("en-ZA", {
                day: "numeric",
                month: "long",
                year: "numeric"
            });
        }

        function formatPrice(price) {
            if (price === null || price === undefined) {
                return "Price not specified";
            }

            return new Intl.NumberFormat("en-ZA", {
                style: "currency",
                currency: "ZAR"
            }).format(price);
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function renderWishlist(items) {
            const container = document.getElementById("wishlistContainer");
            const count = document.getElementById("wishlistCount");

            if (!items || items.length === 0) {
                count.textContent = "0 items";

                container.innerHTML = `
                    <div class="empty-state">
                        <i data-lucide="gift" size="38"></i>
                        <h3>No wishlist items yet</h3>
                        <p>This event doesn't have any gifts on its wishlist.</p>
                    </div>
                `;

                lucide.createIcons();
                return;
            }

            count.textContent =
                `${items.length} ${items.length === 1 ? "item" : "items"}`;

            container.innerHTML = items.map(item => {

                const imageUrl =
                    item.imageUrl ||
                    "https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?w=500";

                const statusClass =
                    item.isClaimed ? "claimed" : "available";

                const statusText =
                    item.isClaimed ? "Claimed" : "Available";

                return `
                    <article class="wishlist-card">

                        <img
                            class="wishlist-image"
                            src="${escapeHtml(imageUrl)}"
                            alt="${escapeHtml(item.name || "Wishlist item")}"
                            loading="lazy"
                        >

                        <div class="wishlist-content">

                            <h3>
                                ${escapeHtml(item.name || "Wishlist item")}
                            </h3>

                            <p class="wishlist-description">
                                ${escapeHtml(
                                    item.description ||
                                    "No description provided."
                                )}
                            </p>

                            <div class="wishlist-bottom">

                                <span class="price">
                                    ${formatPrice(item.price)}
                                </span>

                                <span class="status ${statusClass}">
                                    <i
                                        data-lucide="circle-check"
                                        size="13">
                                    </i>
                                    ${statusText}
                                </span>

                            </div>

                        </div>

                    </article>
                `;

            }).join("");

            lucide.createIcons();
        }

        function openInvitationForm() {

    document.getElementById("invitationForm").style.display = "block";

    document.getElementById("guestName").focus();

    lucide.createIcons();
}


function closeInvitationForm() {

    document.getElementById("invitationForm").style.display = "none";

    document.getElementById("guestName").value = "";
    document.getElementById("guestEmail").value = "";
    document.getElementById("guestPhone").value = "";

    const error = document.getElementById("invitationFormError");

    error.style.display = "none";
    error.textContent = "";
}


async function sendInvitation() {

    const name =
        document.getElementById("guestName").value.trim();

    const email =
        document.getElementById("guestEmail").value.trim();

    const phone =
        document.getElementById("guestPhone").value.trim();

    const errorBox =
        document.getElementById("invitationFormError");


    errorBox.style.display = "none";
    errorBox.textContent = "";


    if (!name) {

        errorBox.textContent =
            "Guest name is required.";

        errorBox.style.display = "block";

        return;
    }


    if (!email && !phone) {

        errorBox.textContent =
            "Please provide either an email address or phone number.";

        errorBox.style.display = "block";

        return;
    }


    if (!eventId) {

        errorBox.textContent =
            "No event ID was found.";

        errorBox.style.display = "block";

        return;
    }


    const sendButton =
        document.querySelector(".send-button");

    sendButton.disabled = true;
    sendButton.innerHTML = "Creating...";


    try {

        const response = await fetch(
            `${API_URL}/${encodeURIComponent(eventId)}/invitations`,
            {
                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                credentials: "include",

                body: JSON.stringify({

                    guestName: name,

                    guestEmail:
                        email || null,

                    guestPhoneNumber:
                        phone || null

                })
            }
        );


        const result =
            await response.json();


        if (!response.ok) {

            throw new Error(
                result.message ||
                "Failed to create invitation."
            );
        }


        closeInvitationForm();


        await loadEvent();


        alert(
            "Invitation created successfully!"
        );


    } catch (error) {

        console.error(
            "Error creating invitation:",
            error
        );


        errorBox.textContent =
            error.message ||
            "Something went wrong.";

        errorBox.style.display =
            "block";


    } finally {

        sendButton.disabled = false;

        sendButton.innerHTML = `
            <i data-lucide="send" size="16"></i>
            Create Invitation
        `;

        lucide.createIcons();
    }
}

        async function loadEvent() {

            if (!eventId) {
                showError(
                    "No event ID was provided in the URL."
                );
                return;
            }

            try {

                const response =
                    await fetch(`${API_URL}/${encodeURIComponent(eventId)}`);

                if (!response.ok) {

                    if (response.status === 404) {
                        throw new Error(
                            "This event could not be found."
                        );
                    }

                    throw new Error(
                        `Server returned status ${response.status}.`
                    );
                }

                const event = await response.json();

                displayEvent(event);

            } catch (error) {

                console.error(
                    "Error loading event:",
                    error
                );

                showError(
                    error.message ||
                    "Something went wrong while loading the event."
                );
            }
        }
        function renderInvitations(invitations) {

            async function copyInvitationLink(inviteGuid) {

    const link =
        `${window.location.origin}/invite.html?invite=${encodeURIComponent(inviteGuid)}`;


    try {

        await navigator.clipboard.writeText(link);

        alert("Invitation link copied!");

    } catch (error) {

        console.error(error);

        prompt(
            "Copy this invitation link:",
            link
        );
    }
}

    const container =
        document.getElementById("invitationList");


    if (!invitations || invitations.length === 0) {

        container.innerHTML = `
            <div class="empty-state">

                <i data-lucide="mail" size="32"></i>

                <h3>No invitations yet</h3>

                <p>
                    Send your first invitation to a guest.
                </p>

            </div>
        `;

        lucide.createIcons();

        return;
    }


    container.innerHTML =
        invitations.map(invitation => {

            const guestName =
                escapeHtml(
                    invitation.guestName ||
                    "Unnamed Guest"
                );


            const email =
                invitation.guestEmail
                    ? escapeHtml(invitation.guestEmail)
                    : "";


            const phone =
                invitation.guestPhoneNumber
                    ? escapeHtml(invitation.guestPhoneNumber)
                    : "";


            const contact =
                email ||
                phone ||
                "No contact information";


            const status =
                escapeHtml(
                    invitation.rsvpStatus ||
                    "Pending"
                );


            const inviteGuid =
                invitation.inviteGuid;


            const invitationUrl =
                `${window.location.origin}/invite.html?invite=${encodeURIComponent(inviteGuid)}`;


            return `
                <div class="invitation-card">

                    <div class="invitation-card-header">

                        <div>

                            <div class="invitation-guest-name">
                                ${guestName}
                            </div>

                            <div class="invitation-contact">
                                ${contact}
                            </div>

                        </div>

                        <span class="invitation-status">
                            ${status}
                        </span>

                    </div>


                    <div class="invitation-actions">

                        <button
                            class="copy-invite"
                            onclick="copyInvitationLink('${inviteGuid}')">

                            📋 Copy Link

                        </button>


                        <button
                            class="whatsapp-invite"
                            onclick="sendWhatsAppInvitation(
                                '${inviteGuid}',
                                '${encodeURIComponent(invitation.guestPhoneNumber || "")}',
                                '${encodeURIComponent(invitation.guestName || "")}'
                            )">

                            WhatsApp

                        </button>


                        <button
                            class="delete-invite"
                            onclick="deleteInvitation(${invitation.id})">

                            Delete

                        </button>

                    </div>

                </div>
            `;

        }).join("");


    lucide.createIcons();
}

        function displayEvent(event) {

            document.getElementById("eventTitle").textContent =
                event.title || "Untitled Event";

            document.getElementById("eventCategory").textContent =
                event.category || "General";

            document.getElementById("eventDescription").textContent =
                event.description || "No description provided.";

            document.getElementById("eventDate").textContent =
                formatDate(event.eventDate);

            document.getElementById("eventVenue").textContent =
                event.venueLocation || "Not specified";

            document.getElementById("eventTheme").textContent =
                event.theme || "Standard";

            document.getElementById("eventAttire").textContent =
                event.attire || "Casual";

            renderWishlist(
                event.wishlistItems || []
            );

            const invitations =
                event.invitations || [];

            document.getElementById("invitationCount").textContent =
                invitations.length;
                renderInvitations(invitations);

            loading.style.display = "none";
            errorBox.style.display = "none";
            eventContent.style.display = "block";

            lucide.createIcons();
        }

        function showError(message) {

            loading.style.display = "none";

            eventContent.style.display = "none";

            errorMessage.textContent = message;

            errorBox.style.display = "block";

            lucide.createIcons();
        }

        lucide.createIcons();

        loadEvent();
    </script>

