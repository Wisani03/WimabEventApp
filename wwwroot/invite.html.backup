<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wimab Event Hub - You're Invited!</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .bg-primary { background-color: #001f5b; }
        .text-primary { color: #001f5b; }
        .bg-accent { background-color: #c89a2c; }
        .text-accent { color: #c89a2c; }
        .border-accent { border-color: #c89a2c; }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 antialiased min-h-screen flex items-center justify-center p-4 sm:p-6">

    <div class="max-w-2xl w-full bg-white text-gray-800 rounded-3xl shadow-2xl overflow-hidden border border-gray-100">
        
        <!-- Header Banner -->
        <div class="bg-primary text-white p-8 text-center relative">
            <div class="absolute top-4 right-4 bg-accent/20 text-accent px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Official Invitation</div>
            <span class="text-accent text-sm font-semibold uppercase tracking-widest">You Are Cordially Invited To</span>
            <h1 id="eventTitleDisplay" class="text-3xl sm:text-4xl font-bold mt-2 mb-1">Exclusive Celebration</h1>
            <p id="eventThemeDisplay" class="text-gray-300 text-sm italic">Theme & Dress Code: Standard</p>
        </div>

        <!-- Main Invitation Content -->
        <div class="p-6 sm:p-8 space-y-6">
            
            <!-- Details Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 flex items-center space-x-3">
                    <div class="p-3 bg-white text-primary rounded-xl shadow-sm">
                        <i data-lucide="map-pin" class="w-5 h-5 text-accent"></i>
                    </div>
                    <div>
                        <div class="text-xs font-semibold uppercase text-gray-400">Venue Location</div>
                        <div id="eventVenueDisplay" class="font-bold text-primary text-sm mt-0.5">Rosebank Rooftop, Johannesburg</div>
                    </div>
                </div>
                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 flex items-center space-x-3">
                    <div class="p-3 bg-white text-primary rounded-xl shadow-sm">
                        <i data-lucide="calendar" class="w-5 h-5 text-accent"></i>
                    </div>
                    <div>
                        <div class="text-xs font-semibold uppercase text-gray-400">Date & Time</div>
                        <div id="eventDateDisplay" class="font-bold text-primary text-sm mt-0.5">Saturday, 18:00 SAST</div>
                    </div>
                </div>
            </div>

            <!-- RSVP Form Container -->
            <div id="rsvpSection" class="bg-blue-50/50 border border-blue-100 p-6 rounded-2xl">
                <h3 class="font-bold text-primary text-lg mb-4 flex items-center space-x-2">
                    <i data-lucide="check-square" class="w-5 h-5 text-accent"></i>
                    <span>Submit Your RSVP Response</span>
                </h3>
                <!-- RSVP COUNTDOWN -->
<div id="rsvpCountdown"
     class="mb-5 bg-white border border-blue-100 rounded-2xl p-4 text-center shadow-sm">

    <div class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
        RSVP closes in
    </div>

    <div id="countdownTimer"
         class="text-2xl sm:text-3xl font-bold text-primary tracking-wide">
        Loading...
    </div>

    <div id="countdownMessage"
         class="text-xs text-gray-500 mt-2">
        Please submit your response before the deadline.
    </div>
</div>

                <form id="publicRsvpForm" onsubmit="submitRsvp(event)" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">First Name</label>
                            <input type="text" id="pubName" required placeholder="e.g., John" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">Surname</label>
                            <input type="text" id="pubSurname" required placeholder="e.g., Doe" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-sm">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">Mobile / WhatsApp</label>
                            <input type="text" id="pubPhone" required placeholder="+27821234567" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">Response</label>
                            <select id="pubStatus" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-sm">
                                <option value="true">Accept Invitation (Attending)</option>
                                <option value="false">Decline Invitation</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">Dietary Requirements</label>
                        <input type="text" id="pubDiet" placeholder="e.g., Vegetarian / Halaal / None" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">Plus One Name (Optional)</label>
                        <input type="text" id="pubPlusOne" placeholder="e.g., Jane Doe" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none text-sm">
                    </div>
                    <button type="submit" class="w-full bg-primary text-white py-4 rounded-xl font-bold hover:bg-accent hover:text-primary transition shadow-md">
                        Confirm RSVP
                    </button>
                </form>
            </div>

            <!-- Wishlist & Gift Claiming Section -->
            <div id="giftWishlistSection" class="hidden space-y-6">
                <div class="bg-amber-50 border border-amber-200 p-6 rounded-2xl text-center space-y-2">
                    <div class="w-10 h-10 bg-accent text-primary rounded-full flex items-center justify-center mx-auto shadow-sm">
                        <i data-lucide="gift" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-xl font-bold text-primary">RSVP Confirmed!</h3>
                    <p class="text-gray-600 text-sm">Your host would love a gift from their wishlist. Claim an item below to bring along!</p>
                </div>

                <div id="publicRegistryList" class="space-y-3 max-h-64 overflow-y-auto pr-1"></div>

                <button onclick="proceedToPass()" class="w-full bg-primary text-white py-3.5 rounded-xl font-bold hover:bg-accent hover:text-primary transition shadow-md text-sm flex items-center justify-center space-x-2">
                    <span>Continue to Scan-Ready QR Entry Ticket</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Success Pass & Real QR Code Section -->
            <div id="successPassSection" class="hidden text-center bg-emerald-50 border border-emerald-100 p-8 rounded-2xl space-y-4">
                <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mx-auto shadow-md">
                    <i data-lucide="check" class="w-6 h-6"></i>
                </div>
                <h3 class="text-2xl font-bold text-emerald-900">You're All Set!</h3>
                <p class="text-emerald-700 text-sm">Your seat has been reserved. Present this scan-ready QR code at the venue entrance.</p>
                
                <div class="bg-white p-6 rounded-2xl border border-emerald-200 inline-block shadow-sm">
                    <div id="qrcode" class="flex justify-center mb-3"></div>
                    <div id="ticketTextCode" class="font-mono text-sm font-bold text-gray-700 tracking-wider"></div>
                    <div class="text-[11px] text-gray-400 mt-2">Scan-ready entry pass for event security</div>
                </div>

                <div class="pt-2">
                    <button onclick="window.print()" class="inline-block bg-primary text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-accent hover:text-primary transition shadow-md flex items-center justify-center space-x-2 mx-auto">
                        <i data-lucide="printer" class="w-4 h-4"></i>
                        <span>Print / Save Pass</span>
                    </button>
                </div>
            </div>

        </div>
    </div>

    <script>
        lucide.createIcons();

        let generatedTicketCode = '';
        const urlParams = new URLSearchParams(window.location.search);
        // Extracts eventId from query string (?id=1) or defaults to 1
        const eventId = urlParams.get('id') || 1;
        const inviteGuid = urlParams.get('inviteGuid');

        // =========================================================
// LOAD INVITATION
// =========================================================

window.onload = async function () {

    const savedTitle = localStorage.getItem('wimab_event_title');

    if (savedTitle) {
        document.getElementById('eventTitleDisplay').innerText =
            savedTitle;
    }

    if (!inviteGuid) {
        showInvitationError(
            'This invitation link is missing its invitation code.'
        );
        return;
    }

    await loadInvitation();
};


// =========================================================
// LOAD INVITATION DETAILS FROM BACKEND
// =========================================================

async function loadInvitation() {

    try {

        const response = await fetch(
            `/api/invitations/public/${inviteGuid}`
        );

        const result = await response.json();

        if (!response.ok) {

            showInvitationError(
                result.message ||
                'This invitation could not be loaded.'
            );

            return;
        }

        const event = result.eventDetails;
        const invitation = result.invitation;

        // ---------------------------------------------
        // DISPLAY EVENT INFORMATION
        // ---------------------------------------------

        document.getElementById('eventTitleDisplay').innerText =
            event.title;

        document.getElementById('eventThemeDisplay').innerText =
            `Theme & Dress Code: ${
                event.theme || 'Standard'
            }`;

        document.getElementById('eventVenueDisplay').innerText =
            event.venueLocation || 'Venue to be confirmed';

        if (event.eventDate) {

            const eventDate = new Date(event.eventDate);

            document.getElementById('eventDateDisplay').innerText =
                eventDate.toLocaleString('en-ZA', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });
        }

        // ---------------------------------------------
        // CHECK RSVP STATUS
        // ---------------------------------------------

        if (invitation.rsvpStatus === 'Accepted') {

            document
                .getElementById('rsvpSection')
                .classList.add('hidden');

            generatedTicketCode =
                invitation.ticketCode || '';

            if (generatedTicketCode) {

                generateTicketAndFinish(
                    generatedTicketCode,
                    invitation.guestName,
                    ''
                );
            }

            return;
        }

        if (invitation.rsvpStatus === 'Declined') {

            disableRsvpForm();

            document.getElementById('countdownTimer').innerText =
                'RSVP Declined';

            return;
        }

        // ---------------------------------------------
        // START COUNTDOWN
        // ---------------------------------------------

        startRsvpCountdown(
            event.rsvpDeadline,
            result.rsvpClosed
        );

    } catch (error) {

        console.error(
            'Error loading invitation:',
            error
        );

        showInvitationError(
            'Unable to load this invitation. Please try again.'
        );
    }
}


// =========================================================
// RSVP COUNTDOWN
// =========================================================

let countdownInterval = null;

function startRsvpCountdown(deadline, alreadyClosed) {

    const timer =
        document.getElementById('countdownTimer');

    const message =
        document.getElementById('countdownMessage');

    // No deadline configured
    if (!deadline) {

        timer.innerText = 'No deadline';

        message.innerText =
            'Please submit your RSVP when you are ready.';

        return;
    }

    function updateCountdown() {

        const deadlineDate =
            new Date(deadline);

        const now =
            new Date();

        const difference =
            deadlineDate.getTime() - now.getTime();

        if (
            alreadyClosed ||
            difference <= 0
        ) {

            clearInterval(countdownInterval);

            timer.innerText =
                '00:00:00';

            message.innerText =
                'The RSVP deadline has passed.';

            disableRsvpForm();

            return;
        }

        const totalSeconds =
            Math.floor(difference / 1000);

        const days =
            Math.floor(totalSeconds / 86400);

        const hours =
            Math.floor(
                (totalSeconds % 86400) / 3600
            );

        const minutes =
            Math.floor(
                (totalSeconds % 3600) / 60
            );

        const seconds =
            totalSeconds % 60;

        timer.innerText =
            `${days}d ` +
            `${String(hours).padStart(2, '0')}:` +
            `${String(minutes).padStart(2, '0')}:` +
            `${String(seconds).padStart(2, '0')}`;

        message.innerText =
            'Please submit your response before the deadline.';
    }

    updateCountdown();

    countdownInterval =
        setInterval(updateCountdown, 1000);
}


// =========================================================
// DISABLE RSVP FORM
// =========================================================

function disableRsvpForm() {

    const form =
        document.getElementById('publicRsvpForm');

    if (!form) return;

    form.querySelectorAll('input, select, button')
        .forEach(element => {
            element.disabled = true;
        });

    const button =
        form.querySelector('button[type="submit"]');

    if (button) {

        button.innerText =
            'RSVP Closed';

        button.classList.remove(
            'bg-primary',
            'hover:bg-accent'
        );

        button.classList.add(
            'bg-gray-400',
            'cursor-not-allowed'
        );
    }
}


// =========================================================
// INVITATION ERROR
// =========================================================

function showInvitationError(message) {

    const section =
        document.getElementById('rsvpSection');

    if (!section) return;

    section.innerHTML = `
        <div class="text-center py-6">

            <div class="text-red-500 mb-3">
                <i data-lucide="alert-circle"
                   class="w-10 h-10 mx-auto"></i>
            </div>

            <h3 class="font-bold text-primary text-lg">
                Invitation Unavailable
            </h3>

            <p class="text-gray-500 text-sm mt-2">
                ${message}
            </p>

        </div>
    `;

    lucide.createIcons();
}
// =========================================================
// SUBMIT RSVP THROUGH INVITATION API
// =========================================================
async function submitRsvp(e) {
    e.preventDefault();

    const isAttending =
        document.getElementById('pubStatus').value === 'true';

    const guestNameVal =
        document.getElementById('pubName').value.trim();

    const guestSurnameVal =
        document.getElementById('pubSurname').value.trim();

    const inviteGuid = urlParams.get('inviteGuid');

    if (!inviteGuid) {
        alert('This invitation link is invalid or incomplete.');
        return;
    }

    const rsvpRequest = {
        name: guestNameVal,
        surname: guestSurnameVal,
        phone: document.getElementById('pubPhone').value.trim(),
        isAttending: isAttending,
        dietaryRequirements:
            document.getElementById('pubDiet').value.trim(),
        plusOneName:
            document.getElementById('pubPlusOne').value.trim()
    };

    try {
        const response = await fetch(
            `/api/invitations/public/${inviteGuid}/rsvp`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(rsvpRequest)
            }
        );

        const result = await response.json();

        if (!response.ok) {

            // RSVP deadline has passed
            if (result.rsvpClosed) {
                alert(
                    result.message ||
                    'The RSVP deadline for this event has passed.'
                );

                disableRsvpForm();
                return;
            }

            alert(
                result.message ||
                'Failed to submit RSVP. Please check your information.'
            );

            return;
        }

        // Save ticket code returned by the C# backend
        generatedTicketCode = result.ticketCode || '';

        document
            .getElementById('rsvpSection')
            .classList.add('hidden');

        if (isAttending) {

            loadPublicRegistry();

            document
                .getElementById('giftWishlistSection')
                .classList.remove('hidden');

        } else {

            generateTicketAndFinish(
                generatedTicketCode,
                guestNameVal,
                guestSurnameVal
            );
        }

    } catch (error) {

        console.error('Error submitting RSVP:', error);

        alert(
            'Network error while submitting RSVP. Please try again.'
        );
    }
}

        async function loadPublicRegistry() {
            const container = document.getElementById('publicRegistryList');
            
            try {
                const response = await fetch(`/api/public/events/${eventId}/wishlist`);
                if (!response.ok) throw new Error('Failed to load wishlist');
                
                const items = await response.json();

                if (items.length === 0) {
                    container.innerHTML = `<div class="text-center text-gray-500 text-sm p-4 bg-white rounded-xl border border-gray-100">No items currently listed on the host wishlist. You can proceed directly!</div>`;
                    return;
                }

                container.innerHTML = items.map(item => `
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 flex items-center justify-between shadow-sm">
                        <div>
                            ${item.imageUrl ? `<img src="${item.imageUrl}" class="w-12 h-12 object-cover rounded-xl mb-2" alt="${item.name}">` : ''}
                            <span class="text-[10px] bg-amber-50 text-accent font-semibold px-2 py-0.5 rounded-full">
                                ${item.price ? new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(item.price) : 'Wishlist Item'}
                            </span>
                            <h4 class="font-bold text-primary text-sm mt-1">${item.name}</h4>
                            <p class="text-gray-500 text-xs">${item.description || ''}</p>
                        </div>
                        <div>
                            <button onclick="claimRegistryItem(${item.id})" id="claim-btn-${item.id}" class="text-xs font-bold px-4 py-2 rounded-xl transition flex items-center space-x-1 ${item.isClaimed ? 'bg-green-100 text-green-700 pointer-events-none' : 'bg-primary text-white hover:bg-accent hover:text-primary'}">
                                <span>${item.isClaimed ? `Claimed (${item.claimedByGuestName || 'Guest'})` : 'Claim Gift'}</span>
                            </button>
                        </div>
                    </div>
                `).join('');
                lucide.createIcons();
            } catch (err) {
                console.error("Error fetching public wishlist:", err);
                container.innerHTML = `<div class="text-center text-gray-500 text-sm p-4 bg-white rounded-xl border border-gray-100">Could not load gift registry at this time.</div>`;
            }
        }

        async function claimRegistryItem(itemId) {
            const guestNameVal = document.getElementById('pubName').value.trim();
            const guestSurnameVal = document.getElementById('pubSurname').value.trim();
            const fullName = `${guestNameVal} ${guestSurnameVal}`;

            try {
                const res = await fetch(`/api/wishlist/claim/${itemId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ guestName: fullName })
                });

                if (res.ok) {
                    loadPublicRegistry();
                } else {
                    alert('Failed to claim gift. It may already be claimed.');
                }
            } catch (err) {
                console.error("Error claiming gift:", err);
                alert('Network error while claiming gift.');
            }
        }

        function proceedToPass() {
            const gName = document.getElementById('pubName').value;
            const gSurname = document.getElementById('pubSurname').value;
            
            document.getElementById('giftWishlistSection').classList.add('hidden');
            generateTicketAndFinish(generatedTicketCode || 'WIMAB-TICKET', gName, gSurname);
        }

        function generateTicketAndFinish(ticketCode, name, surname) {
            document.getElementById('successPassSection').classList.remove('hidden');
            document.getElementById('ticketTextCode').innerText = ticketCode;

            document.getElementById('qrcode').innerHTML = ""; 
            new QRCode(document.getElementById("qrcode"), {
                text: `Wimab Event Ticket Verified: ${name} ${surname} [${ticketCode}]`,
                width: 140,
                height: 140,
                colorDark : "#001f5b",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });
            lucide.createIcons();
        }
    </script>
</body>
</html>